generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 🛡️ Tabela de Administradores (Torre de Controle Web)
model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MONITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MONITOR
}

// 👤 Tabela de Usuários (Donos dos Celulares)
model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String    // bcrypt hash
  phone         String
  cpf           String    @unique               // Obrigatório
  birthDate     DateTime?
  profilePhoto  String?   // URL Supabase Storage
  city          String?   // Contexto para dossier
  
  pinSeguro     String    // PIN principal — abre o app e confirma monitoramento
  pinTeatro     String    // PIN teatro — abre Cofre Falso (bloqueia 15 min depois)
  pinEmergencia String?   // PIN bloqueio instantâneo
  emergencyNote String?   // Mensagem para dossier
  
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  devices        Device[]
  unlockRequests UnlockRequest[]
}

// 📱 Tabela Central de Dispositivos
model Device {
  id        String   @id @default(uuid()) // O UUID único que o Android cria
  fcmToken  String?  // O token gigante do Firebase para aquele celular específico
  status    Status   @default(SECURE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dono do dispositivo
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamentos
  locations  Location[]
  timers     Timer[]
  panics     PanicEvent[]
  contacts   Contact[]
  safeZones  SafeZone[]
}

// Estados possíveis de um celular na Torre de Controle
enum Status {
  SECURE
  ALERTA
  PANICO
}

// Pedidos de desbloqueio remoto
model UnlockRequest {
  id          String   @id @default(uuid())
  status      UnlockStatus @default(PENDING)   // PENDING, APPROVED, DENIED
  selfieUrl   String?                          // Foto enviada pelo usuário
  adminNote   String?                          // Nota do admin
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UnlockStatus {
  PENDING
  APPROVED
  DENIED
}

// 📍 Histórico de Rastreio GPS (A Rota de Resgate)
model Location {
  id        Int      @id @default(autoincrement())
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp(sort: Desc)]) // Índice para buscas ultra-rápidas na Torre de Controle
}

// ⏰ Smart Timer — Registro persistente de evento com prazo de segurança
model Timer {
  id              Int      @id @default(autoincrement())
  eventName       String   // Nome do evento, ex: "Indo para a academia"
  targetTimestamp DateTime // Timestamp exato em que o alarme deve ser auditado pelo CronJob
  checkedIn       Boolean  @default(false) // true = usuária desarmou manualmente. A bomba foi desativada.
  isActive        Boolean  @default(true)  // false = timer encerrado (por checkin ou por expiração processada)
  createdAt       DateTime @default(now())

  // FK para o dispositivo dono deste timer
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // FK opcional para a Zona Segura de destino
  safeZoneId String?
  safeZone   SafeZone? @relation(fields: [safeZoneId], references: [id], onDelete: SetNull)

  // Relação N:M: quais contatos devem ser notificados SE este timer expirar sem check-in
  contacts Contact[] @relation("TimerContacts")

  @@index([isActive, targetTimestamp]) // Índice vital para o futuro CronJob de auditoria
}

// 👥 Contatos de Emergência do Usuário
model Contact {
  id    String @id @default(uuid())
  name  String
  phone String

  // FK para o dispositivo dono deste contato
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Relação N:M inversa com Timer
  timers Timer[] @relation("TimerContacts")
}

// 🗺️ Zonas Seguras cadastradas pelo Usuário
model SafeZone {
  id           String @id @default(uuid())
  name         String  // Ex: "Casa", "Trabalho", "Academia"
  latitude     Float
  longitude    Float
  radiusMeters Int     // Raio em metros considerado "dentro da zona segura"

  // FK para o dispositivo dono desta zona
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Um timer pode ter uma zona segura associada
  timers Timer[]
}

// 🚨 Registro de Auditoria de Pânicos
model PanicEvent {
  id          Int      @id @default(autoincrement())
  triggerType String   // Ex: GATILHO_VOZ_OFFLINE, INTERCEPTACAO_BANCO
  timestamp   DateTime @default(now())
  resolved    Boolean  @default(false) // Se o admin na Torre de Controle já validou/cancelou

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}